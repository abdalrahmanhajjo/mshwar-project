# Mshwar API - environment variables (names are case-insensitive).
# Copy to services/api/.env for local runs. Never commit real secrets:
# staging/production values come from the platform secret store.

# development | test | staging | production
# staging/production refuse to start with default secrets, dev endpoints or stub payments.
ENVIRONMENT=development

# Database - LOCAL ONLY
# staging/production must connect as a login role that is a member of mshwar_backend and is
# neither a superuser nor BYPASSRLS; the API refuses to start otherwise (docs/security/database-roles.md).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mshwar
# Tests only: an admin connection for fixtures when DATABASE_URL uses the restricted role.
TEST_ADMIN_DATABASE_URL=

# Rate limiting (docs/security/rate-limits.md). memory = per process (development/tests).
# staging/production require redis so limits hold across workers.
RATE_LIMIT_STORE=memory
REDIS_URL=redis://localhost:6379/0

# Auth / security
# Signs download links. staging/production: at least 32 random characters.
SECRET_KEY=change-me-in-production
# Shared secret for cron/worker calls (header X-Job-Token): checkout ops, notification dispatch.
# staging/production: at least 32 random characters. NOTIFICATION_DISPATCH_TOKEN is still accepted.
INTERNAL_JOB_TOKEN=
# Test-only endpoints (payment simulation, fault injection). Local development only.
ENABLE_DEV_ENDPOINTS=true
# Reverse proxies in front of the API (the Next.js rewrite counts as 1).
TRUSTED_PROXY_COUNT=1
ALLOWED_ORIGINS=["http://localhost:3000"]
# The web app origin. staging/production: the https:// site origin (trusted for cookie-carrying writes).
PUBLIC_WEB_ORIGIN=http://localhost:3000

# Connection pool
POOL_SIZE=5
MAX_OVERFLOW=10
POOL_RECYCLE=1800
CONNECT_TIMEOUT=10
STATEMENT_TIMEOUT_MS=30000
# Log every SQL statement with parameters. Never in shared environments.
SQL_ECHO=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# External services - LOCAL ONLY (use the platform secret store for staging/production)
GOOGLE_MAPS_API_KEY=
CATALOGUE_ROUTING_PROVIDER=auto
ROUTING_CACHE_TTL_SECONDS=21600
WEATHER_PROVIDER=stub
# AI trip builder. Empty OPENAI_API_KEY forces the deterministic stub LLM.
OPENAI_API_KEY=
PLANNER_LLM_PROVIDER=stub
PLANNER_LLM_MAX_ATTEMPTS=2
PLANNER_FAULT_INJECT=
# AI spending ceiling, per Beirut calendar day (docs/security/rate-limits.md).
AI_REQUEST_COST_USD=0.01
AI_USER_DAILY_BUDGET_USD=0.25
AI_GLOBAL_DAILY_BUDGET_USD=50

# Payments. Without STRIPE_SECRET_KEY the adapter is a local stub that settles instantly
# (development/test only). Webhooks are rejected until STRIPE_WEBHOOK_SECRET is set.
PAYMENT_PROVIDER=stripe_test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_FAULT=
IDEMPOTENCY_TTL_HOURS=24

# Files (docs/security/uploads.md). Listing images go to ImageKit when both values are set;
# otherwise they stay in local storage. Verification documents are always private and local.
# Production needs a persistent PRIVATE_STORAGE_DIR.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
PRIVATE_STORAGE_DIR=/tmp/mshwar-private
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_IMAGES_PER_EXPERIENCE=20
UPLOAD_ORG_HOURLY_LIMIT=60
UPLOAD_ORG_QUOTA_BYTES=524288000
SIGNED_URL_TTL_SECONDS=900
STAFF_INVITE_TTL_SECONDS=604800

# Email (empty = stub adapter that only logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@mshwar.local
SENDGRID_API_KEY=

# Monitoring (docs/security/logging-and-monitoring.md). Empty SENTRY_DSN = no error reporting.
# Events are scrubbed of secrets and personal data before they leave the process.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Release tag attached to logs and Sentry events (GIT_SHA is also accepted).
RELEASE=
ACCESS_LOG=true
