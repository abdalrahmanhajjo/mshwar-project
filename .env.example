# App
NODE_ENV=development
# Web: show the bundled sample catalogue when the API is unreachable.
# Defaults to true in development and false in production builds; set true only for demo previews.
CATALOGUE_SAMPLE_FALLBACK=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mshwar

# Redis (shared rate limits; required by the API in staging/production)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORE=memory

# API (full list with comments: services/api/.env.example)
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
INTERNAL_JOB_TOKEN=
ENABLE_DEV_ENDPOINTS=true
TRUSTED_PROXY_COUNT=1
SQL_ECHO=false

# External Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Browser Maps (referrer-restricted). Empty = list/pin fallback. Do not commit a real key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Catalogue search embeddings: stub (CI default) or a real provider name.
CATALOGUE_EMBEDDING_PROVIDER=stub
# auto = Google when GOOGLE_MAPS_API_KEY is set, else Haversine+road-factor stub.
# unavailable = mark travel metrics unavailable (never a silent fake estimate).
CATALOGUE_ROUTING_PROVIDER=auto
ROUTING_CACHE_TTL_SECONDS=21600
ROUTING_PLAN_BUDGET_USD=0.5
# stub = recorded fixture (CI). open-meteo = public prototype API (no SLA).
# Production: commercial Open-Meteo, Meteomatics, or self-hosted Open-Meteo — see docs/maps-routing-weather.md.
WEATHER_PROVIDER=stub
OPEN_METEO_API_KEY=
# AI trip builder. Empty OPENAI_API_KEY forces the deterministic stub LLM.
OPENAI_API_KEY=
PLANNER_LLM_PROVIDER=stub
PLANNER_LLM_MAX_ATTEMPTS=2
PLANNER_FAULT_INJECT=
# Payments (Epic 9). Empty Stripe keys keep the local stub adapter.
# Lebanon is not on Stripe's global availability page — see docs/payments.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_PROVIDER=stripe_test
PAYMENTS_FAULT=
IDEMPOTENCY_TTL_HOURS=24
# Image uploads: leave IMAGEKIT_* empty to use the local private-storage stub.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Web: same URL endpoint, so listing images resolve to ImageKit delivery URLs.
NEXT_PUBLIC_IMAGEKIT_URL=
PRIVATE_STORAGE_DIR=/tmp/mshwar-private
SIGNED_URL_TTL_SECONDS=900

# Admin / operations (Epic 6). Scheduler stays off unless explicitly enabled.
# Cron POST /api/v1/admin/quality/run instead of a process loop in pytest/CI.
SEARCH_REINDEX_PROVIDER=stub
DATA_QUALITY_SCHEDULER_ENABLED=false
DATA_QUALITY_STALE_DAYS=14

# Email. MAILER_BACKEND=console (default, logs only) | smtp (sends real mail) |
# notification (queue stub). Set it to smtp and fill SMTP_* to deliver
# verification and password-reset email. Port 465 uses implicit TLS; anything
# else (587) uses STARTTLS.
MAILER_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@mshwar.local
SENDGRID_API_KEY=
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_WORKER_BATCH_SIZE=25

# Monitoring (MSHWAR-111). Empty = off. The browser DSN is used only after the visitor
# allows "Error reporting" in Cookie settings.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_RELEASE=

# Trust documents (MSHWAR-113). Operator details shown in the terms and privacy policy.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
# Set to true only after a lawyer has approved the published versions (hides the draft notice).
NEXT_PUBLIC_LEGAL_REVIEWED=true
