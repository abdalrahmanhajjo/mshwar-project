# Staging reverse proxy. One hostname serves both surfaces:
#   /api/*, /health, /docs  -> the FastAPI service
#   everything else         -> the Next.js app
#
# SITE_ADDRESS comes from the environment (see docker-compose.staging.yml) so the
# hostname can change without editing this file. Caddy obtains and renews the
# certificate automatically.
{$SITE_ADDRESS} {
	encode zstd gzip

	@api path /api/* /health /docs /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
